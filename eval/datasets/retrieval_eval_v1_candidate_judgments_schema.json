{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asd-rag/retrieval_eval_v1_candidate_judgments",
  "title": "ASD-RAG T2.3.2 candidate-pool judgment (one JSONL line per question × chunk × annotator)",
  "description": "Extension of retrieval_eval_v1. Every row of the T2.3.1 dense candidate pool has exactly one row here. Only status=judged rows are merged into v1 `judgments`; needs_adjudication and unjudged stay candidates and are NEVER read as grade 0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["judgment_version", "judgment_id", "question_id", "chunk_id", "document_id", "source_id",
               "content_sha256", "status", "grade", "evidence_class", "aspect", "rationale_vi", "exclusion_reason",
               "annotator", "annotated_at", "judging_protocol", "origin", "corpus", "base_dataset"],
  "properties": {
    "judgment_version": {"const": "t2_3_2_v1"},
    "judgment_id": {"type": "string", "pattern": "^[0-9a-f]{20}$", "description": "sha256(question_id|chunk_id|annotator_id)[:20]"},
    "question_id": {"type": "string", "pattern": "^q[0-9]{3}$"},
    "chunk_id": {"type": "string"},
    "document_id": {"type": "string"},
    "source_id": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "hash of the chunk text that was read"},
    "status": {"enum": ["judged", "needs_adjudication", "excluded", "unjudged"]},
    "grade": {"enum": [-1, 0, 1, 2, 3, null], "description": "final (judged) or provisional (needs_adjudication); null for excluded/unjudged"},
    "evidence_class": {"enum": ["relevant", "partial", "negative", "conflicting", null]},
    "aspect": {"type": ["string", "null"]},
    "rationale_vi": {"type": ["string", "null"]},
    "exclusion_reason": {"type": ["string", "null"]},
    "annotator": {"type": ["object", "null"], "required": ["annotator_id", "annotator_type"],
      "properties": {"annotator_id": {"type": "string"}, "annotator_type": {"enum": ["human", "ai_model"]}, "model": {"type": "string"}}},
    "annotated_at": {"type": ["string", "null"], "description": "ISO-8601; time the judgment batch was saved"},
    "judging_protocol": {"type": "string"},
    "origin": {"type": "object", "required": ["pool", "pool_sha256", "question_group", "rank", "suggested_review_priority"],
      "description": "provenance only: rank/score were hidden from the annotator while judging"},
    "corpus": {"type": "object", "required": ["chunking_profile", "embedding_profile", "embedding_manifest_sha256",
      "authorization_id", "authorization_allowlist", "authorization_allowlist_sha256"]},
    "base_dataset": {"type": "object", "required": ["file", "sha256"]}
  }
}
