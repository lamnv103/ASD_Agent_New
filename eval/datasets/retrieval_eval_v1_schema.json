{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asd-rag/retrieval_eval_v1",
  "title": "ASD-RAG retrieval evaluation record (one JSONL line)",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_version", "question_id", "question_vi", "reference_query_en", "query_category", "query_style",
               "query_complexity", "expected_route", "answerability", "expected_evidence_status",
               "expected_answer_scope", "expected_sources", "relevant_document_ids", "relevant_chunk_ids",
               "relevance_grade", "judgments", "candidate_chunk_ids", "evidence_requirements",
               "requires_multiple_chunks", "requires_multiple_sources", "annotation_status", "label_tier", "annotation_completeness",
               "annotators", "annotation_method", "search_log", "annotation_notes", "corpus"],
  "properties": {
    "dataset_version": {"const": "retrieval_eval_v1"},
    "question_id": {"type": "string", "pattern": "^q[0-9]{3}$"},
    "question_vi": {"type": "string", "minLength": 5},
    "reference_query_en": {"type": "string", "description": "Annotator-written English reference (for the A′ language-gap experiment). Never used as the system query."},
    "query_category": {"enum": ["basic_knowledge", "signs_symptoms", "social_communication", "repetitive_restricted",
                                "assessment_diagnosis", "intervention_support", "sensory", "development_milestones",
                                "aac_communication_support", "multi_aspect", "multi_source", "insufficient_out_of_scope"]},
    "query_style": {"type": "array", "items": {"enum": ["short", "long", "technical", "colloquial", "synonym",
      "multi_chunk", "multi_source", "false_positive_risk", "age_specific", "conflicting"]}},
    "query_complexity": {"enum": ["simple", "moderate", "complex"]},
    "expected_route": {"enum": ["expert_qa", "other"]},
    "answerability": {"enum": ["answerable", "partially_answerable", "unanswerable", "blocked", "out_of_scope"]},
    "expected_evidence_status": {"enum": ["sufficient", "partial", "conflicting", "insufficient", "blocked", "not_applicable"]},
    "expected_answer_scope": {"type": "string"},
    "expected_sources": {"type": "array", "items": {"type": "string"}},
    "relevant_document_ids": {"type": "array", "items": {"type": "string"}},
    "relevant_chunk_ids": {"type": "array", "items": {"type": "string"},
      "description": "Exactly the judged chunks with grade >= 2. Never contains unjudged (candidate) chunks."},
    "relevance_grade": {"type": "object", "additionalProperties": {"enum": [-1, 0, 1, 2, 3]}},
    "judgments": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["chunk_id", "document_id", "source_id", "content_sha256", "grade", "evidence_class", "aspect", "rationale_vi"],
      "properties": {
        "chunk_id": {"type": "string"}, "document_id": {"type": "string"}, "source_id": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "grade": {"enum": [-1, 0, 1, 2, 3]},
        "evidence_class": {"enum": ["relevant", "partial", "negative", "conflicting"]},
        "aspect": {"type": "string"}, "rationale_vi": {"type": "string", "minLength": 3}}}},
    "candidate_chunk_ids": {"type": "array", "items": {"type": "string"},
      "description": "Pooled but NOT yet judged. Never used as gold."},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "requires_multiple_chunks": {"type": "boolean"},
    "requires_multiple_sources": {"type": "boolean"},
    "annotation_status": {"enum": ["pending_annotation", "annotated_single", "adjudicated", "verified_unanswerable", "not_applicable"]},
    "label_tier": {"enum": ["candidate", "silver_single_annotator", "gold_human_verified", "not_applicable"]},
    "annotation_completeness": {"enum": ["complete_for_judged_pool", "partial", "not_applicable"],
      "description": "complete_for_judged_pool = every pooled candidate was judged (recall vs. unpooled chunks still unknown); partial = known gaps in the pool."},
    "annotators": {"type": "array", "items": {"type": "object", "required": ["annotator_id", "annotator_type"],
      "properties": {"annotator_id": {"type": "string"}, "annotator_type": {"enum": ["human", "ai_model"]}}}},
    "annotation_method": {"type": "string"},
    "search_log": {"type": "array", "items": {"type": "string"}},
    "annotation_notes": {"type": "string"},
    "corpus": {"type": "object", "required": ["chunking_profile", "embedding_profile", "embedding_manifest_sha256"]}
  },
  "x-grade-scale": {"3": "highly relevant", "2": "relevant", "1": "partially relevant / context", "0": "irrelevant (verified negative)",
                    "-1": "conflicting or needs context reconciliation (still evidence an answer must surface)"},
  "x-metric-gain": {"3": 3, "2": 2, "1": 1, "0": 0, "-1": 2},
  "x-binary-relevant": "grade >= 2 (conflicting -1 reported separately and counted as required evidence for coverage of the conflict aspect)"
}
